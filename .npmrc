# React Native resout ses modules natifs a plat : l'autolinking Android et iOS
# parcourt node_modules sans suivre les liens symboliques de pnpm. Expo documente
# ce reglage comme prerequis.
node-linker=hoisted

# Le paquet d'impression NYX declare 755 dependances d'execution qui sont en
# realite l'arbre de developpement de son auteur (metro, jest, vm2). On les
# retire par `pnpm patch` ; sans cela un arbre a plat les installerait toutes.
